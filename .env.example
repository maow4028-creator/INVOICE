# ==========================================
# Invoicify Pro Configuration
# ==========================================

# Backend API Port & Database (for optional local Express server)
PORT=5000
DATABASE_URL="file:./dev.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/invoice_db?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
CLIENT_URL="http://localhost:5173"

# Firebase Configuration (for Cloud Auth & Firestore Invoices)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
